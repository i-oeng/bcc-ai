# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env в git не попадает.

# Провайдер модели: gemini (по умолчанию), anthropic или openai (OpenAI и совместимые API)
LLM_PROVIDER=gemini

# --- Google Gemini ---
# Ключ (бесплатно): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Модель. Список доступных вашему ключу: python -m validator --list-models
GEMINI_MODEL=gemini-3.6-flash
# Запасные модели: если основная перегружена (503) или у ключа нет квоты, шаг уходит на следующую
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-4-hydrogen,gemini-3.5-flash-lite,gemma-4-31b-it
# Уровень размышлений для Gemini 3 и новее: low быстрее; пусто = как у модели
GEMINI_THINKING=low
# Температура (пусто = значение модели по умолчанию)
GEMINI_TEMPERATURE=

# --- Anthropic Claude (LLM_PROVIDER=anthropic) ---
# Ключ: https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACK_MODELS=

# --- OpenAI и совместимые API (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_FALLBACK_MODELS=
# Адрес совместимого сервера: OpenRouter https://openrouter.ai/api/v1, DeepSeek https://api.deepseek.com,
# Groq https://api.groq.com/openai/v1, свой vLLM или Ollama (http://localhost:11434/v1). Пусто = api.openai.com
OPENAI_BASE_URL=

# --- Стандарты ---
# Через запятую; ISO/IEC/IEEE 29148 включён всегда. Список: python -m validator --list-standards
VALIDATOR_STANDARDS=iso29148,ieee830
# Папка своих и изменённых стандартов (JSON, формат в validator/criteria.py); пусто: custom_standards/
VALIDATOR_STANDARDS_DIR=

# --- Маскирование чувствительных данных перед отправкой в модель ---
REDACT_ENABLED=1
# Поиск ФИО нейросетевой моделью Natasha (офлайн)
REDACT_NER=1
# Файл со своими терминами для маскирования (по одному на строку): названия систем, хосты, проекты
REDACT_TERMS_FILE=

# --- Скорость ---
# Сколько требований проверять за один запрос
VALIDATOR_BATCH_SIZE=12
# Сколько запросов одной проверки идут одновременно
VALIDATOR_PARALLEL=6
# Если модель молчит дольше N секунд, тот же запрос уходит повторно и берётся первый ответ (0 = выключено)
VALIDATOR_HEDGE_SECONDS=90
# Сколько проверок веб-интерфейс запускает одновременно (остальные ждут в очереди)
VALIDATOR_MAX_JOBS=3
# Сколько раз проверка сама перезапускается после сбоя модели (готовые шаги из кэша) и пауза перед повтором, с
VALIDATOR_AUTO_RETRY=2
VALIDATOR_RETRY_PAUSE=45
# Кэш ответов модели: повторная проверка того же документа продолжит с места сбоя и не тратит квоту
VALIDATOR_CACHE=1

# Часовой пояс для даты в паспорте проверки
VALIDATOR_TZ=Asia/Almaty
